# kernels/BUILD.bazel

load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(
    name = "kernels_header",
    srcs = ["kernels.h"],
    visibility = ["//visibility:public"],
)

# Target for NVIDIA build using the standard cuda_library rule
cuda_library(
    name = "all_kernels_nv",
    srcs = glob(["*/*.hip.cpp"]),
    hdrs = [":kernels_header"],
    deps = ["//src:gpu_runtime"],
    tags = ["nvidia-only"],
)

# Target for AMD build using a standard cc_library with HIP flags
cc_library(
    name = "all_kernels_amd",
    srcs = glob(["*/*.hip.cpp"]),
    hdrs = [":kernels_header"],
    deps = ["//src:gpu_runtime"],
    copts = ["-x hip"],
    tags = ["amd-only"], # Add any other necessary HIP flags here
)

# Alias that selects the correct implementation based on the configuration.
# The bindings/ and other dependencies will point to this virtual target.
alias(
    name = "all_kernels",
    actual = select({
        "//:rocm_config": ":all_kernels_amd",
        "//conditions:default": ":all_kernels_nv",
    }),
    visibility = ["//visibility:public"],
)

# --- Filegroups remain the same ---
filegroup(
    name = "kernels_dir",
    srcs = glob(["**/*"], allow_empty = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "test_data",
    srcs = glob(
        [
            "**/tests/**/*.bin",
            "**/tests/**/*.py",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
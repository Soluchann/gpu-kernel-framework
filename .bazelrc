#.bazelrc
# Use Bzlmod instead of WORKSPACE
common --enable_bzlmod
build --cxxopt=-std=c++17
build --features=header_modules
build --extra_toolchains=@rules_python//python:autodetecting_toolchain_nonstrict
build --enable_runfiles

# New build configuration for ROCm/HIP
# This defines the 'gpu=amd' variable used by the gpu_library rule.
# .bazelrc
build:rocm --define=gpu=amd
build:rocm --build_tag_filters=-nvidia-only
build:rocm --@rules_cuda//cuda:runtime=@@//tools/cuda:cuda_runtime